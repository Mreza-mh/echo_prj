    ROOT --> SG_FE
    ROOT --> SG_BE1
    ROOT --> SG_BE2
    ROOT --> SG_BE3
    ROOT --> SG_IOT

    %% ==================== ارتباطات اصلی ====================
    FE1 --> KONG
    FE2 --> KONG
    FE3 --> KONG
    FE4 --> KONG
    FE5 --> KONG
    FE6 --> KONG
    KONG ==>|"مسیریابی درخواست"| SG_BE1
    SG_BE1 ==>|"Route + RAG"| SG_BE2
    SG_BE1 ==>|"اجرای پردازش"| SG_BE3
    SG_BE1 <==>|"start / stop / data"| SG_IOT

    %% ==================== اتصال پایگاه‌های داده ====================
    SG_BE1 --> DB1
    SG_BE1 --> DB2
    SG_BE2 --> DB3
    SG_BE3 --> DB2

    PLLM1 -.->|"سرویس LLM مشترک"| L4
