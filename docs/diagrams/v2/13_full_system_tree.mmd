            PCV4("قطعه‌بندی حفرات"):::cvmodel
            PCV5("اندازه‌گیری LV / دهلیز / LVOT"):::cvmodel
        end

        subgraph SG_FUZZY["منطق فازی"]
            direction TB
            PF1("تجمیع معیارها"):::fuzzy
            PF2("سطح ریسک ساختاری"):::fuzzy
        end

        subgraph SG_ML["مدل‌های ریسک"]
            direction TB
            PML1("CatBoost"):::mlmodel
            PML2("Logistic Regression"):::mlmodel
        end

        subgraph SG_LLM["تولید گزارش"]
            direction TB
            PLLM1("ArvanCloud LLM"):::llm
            PLLM2("گزارش متنی نهایی"):::llm
        end

        SG_CV --> SG_FUZZY --> SG_ML --> SG_LLM
    end

    %% ==================== اینترنت اشیا ====================
    subgraph SG_IOT["اینترنت اشیا"]
        direction TB
        MQTTNODE("بروکر Mosquitto MQTT"):::iot
        ESP("ESP32 + MAX30102"):::iot
        MQTTNODE <--> ESP
    end

    %% ==================== پایگاه‌های داده ====================
    subgraph SG_DB["پایگاه‌های داده"]
        direction TB
        DB1[("MySQL<br/>کاربران و نوبت‌ها")]:::db
        DB2[("MongoDB<br/>داده بالینی و اکو")]:::db
        DB3[("Qdrant<br/>پایگاه دانش")]:::db
    end

    class SG_FE,SG_BE1,SG_BE2,SG_BE3,SG_IOT,SG_DB grp
    class SG_CV,SG_FUZZY,SG_ML,SG_LLM sub

