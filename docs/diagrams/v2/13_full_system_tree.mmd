    ROOT("سامانه Echo"):::root

    %% ==================== فرانت‌اند ====================
    subgraph SG_FE["فرانت‌اند — Angular"]
        direction TB
        FE1("پنل بیمار"):::front
        FE2("پنل پزشک"):::front
        FE3("پنل مدیریت"):::front
        FE4("نوبت‌گیری هوشمند و چت‌بات"):::front
        FE5("سابقه و گزارش اکو"):::front
        FE6("پایش زنده ضربان قلب"):::front
        FE1 ~~~ FE2 ~~~ FE3 ~~~ FE4 ~~~ FE5 ~~~ FE6
    end

    KONG{{"درگاه API — Kong Gateway"}}:::gateway

    %% ==================== بک‌اند ۱: لاراول ====================
    subgraph SG_BE1["بک‌اند ۱ — Laravel (اصلی)"]
        direction TB
        L1("احراز هویت (Passport / OTP)"):::laravel
        L2("نوبت‌دهی و برنامه کاری"):::laravel
        L3("مدیریت پرسنل و خدمات"):::laravel
        L4("هماهنگ‌کننده چت‌بات"):::laravel
        L5("گزارش و تاریخچه اکو"):::laravel
        L6("گوش‌دهنده MQTT"):::laravel
        L1 ~~~ L2 ~~~ L3
        L4 ~~~ L5 ~~~ L6
    end

    %% ==================== بک‌اند ۲: سرویس هوش مصنوعی ====================
    subgraph SG_BE2["بک‌اند ۲ — سرویس FAISS (FastAPI)"]
        direction TB
        F1("تشخیص نیت پیام"):::faiss
        F2("Embedding محلی"):::faiss
        F3("جستجوی برداری RAG"):::faiss
        F1 ~~~ F2 ~~~ F3
    end

    %% ==================== بک‌اند ۳: خط پردازش اکو ====================
    subgraph SG_BE3["بک‌اند ۳ — خط پردازش اکو (Python CLI، اجرای دستی)"]
        direction TB

        subgraph SG_CV["بینایی ماشین"]
            direction TB
            PCV1("طبقه‌بندی نما (A4C/A2C/PLAX)"):::cvmodel
            PCV2("استخراج چرخه قلبی"):::cvmodel
