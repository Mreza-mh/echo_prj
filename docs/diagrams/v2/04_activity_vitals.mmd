flowchart TD
    classDef startEnd fill:#334155,stroke:#1e293b,color:#fff,font-weight:bold
    classDef user fill:#dbeafe,stroke:#1e40af,color:#1e3a8a
    classDef iot fill:#e5e7eb,stroke:#374151,color:#111827
    classDef server fill:#e2e8f0,stroke:#475569,color:#1e293b
    classDef decision fill:#f1f5f9,stroke:#334155,color:#1e293b
    classDef data fill:#e5e7eb,stroke:#374151,color:#111827

    Start(["fa:fa-play شروع"]):::startEnd --> A["fa:fa-hand-pointer کاربر جلسه پایش را آغاز می‌کند"]:::user
    A --> B["fa:fa-broadcast-tower Laravel فرمان start را به MQTT ارسال می‌کند"]:::server
    B --> C["fa:fa-microchip دستگاه ESP32 فرمان را دریافت می‌کند"]:::iot
    C --> D["fa:fa-heartbeat سنسور MAX30102 ضربان قلب را می‌خواند"]:::iot
    D --> E["fa:fa-paper-plane انتشار داده هر ۲ ثانیه\n(devices/ESP32_001/data)"]:::iot
    E --> F["fa:fa-headphones mqtt:listen داده را در Laravel دریافت می‌کند"]:::server
    F --> G[("fa:fa-save ذخیره VitalReading در MongoDB")]:::data
    G --> H["fa:fa-chart-area نمایش زنده در پنل بیمار (Polling هر ۲ ثانیه)"]:::user

    H --> I{"fa:fa-sync ادامه جلسه؟"}:::decision
    I -->|"مدت کمتر از ۱۵۰ ثانیه"| D
    I -->|"توقف توسط کاربر"| J["fa:fa-stop-circle ارسال فرمان stop"]:::server
    I -->|"قطع MQTT بیش از ۲۰ ثانیه"| J
    I -->|"رسیدن به سقف زمانی"| J

    J --> K{"fa:fa-save ذخیره در پروفایل؟"}:::decision
    K -->|"بله"| L["fa:fa-file-medical ذخیره در پروفایل بالینی بیمار"]:::data
    K -->|"خیر"| End(["fa:fa-stop پایان"]):::startEnd
    L --> End
