%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#eff6ff','primaryBorderColor':'#1e40af','primaryTextColor':'#1e293b','lineColor':'#64748b','fontSize':'15px'}}}%%
stateDiagram-v2
    classDef pending fill:#eff6ff,stroke:#60a5fa,color:#1e3a8a
    classDef active fill:#dbeafe,stroke:#1e40af,color:#1e3a8a
    classDef success fill:#1e40af,stroke:#1e3a8a,color:#ffffff,font-weight:bold
    classDef failure fill:#e2e8f0,stroke:#475569,color:#1e293b

    [*] --> Pending : ثبت درخواست نوبت

    Pending --> Confirmed : تأیید منشی/مدیر
    Pending --> Cancelled : لغو توسط کاربر

    Confirmed --> Reminded : ارسال یادآور خودکار
    Reminded --> InProgress : حضور بیمار در کلینیک
    Confirmed --> Cancelled : لغو نوبت

    InProgress --> Completed : پایان ویزیت
    InProgress --> NoShow : عدم حضور بیمار

    Completed --> [*]
    Cancelled --> [*]
    NoShow --> [*]

    class Pending pending
    class Confirmed,Reminded,InProgress active
    class Completed success
    class Cancelled,NoShow failure

    note right of Pending
        در انتظار تأیید
    end note
    note right of Completed
        گزارش/نسخه در پروفایل ثبت می‌شود
    end note
