%%{init: {'theme':'base', 'flowchart': {'curve':'linear', 'nodeSpacing':45, 'rankSpacing':50, 'padding':10}, 'themeVariables': {'primaryColor':'#eff6ff','primaryBorderColor':'#1e40af','primaryTextColor':'#1e293b','lineColor':'#64748b','fontSize':'14px'}}}%%
flowchart TD
    classDef startEnd fill:#1e40af,stroke:#1e3a8a,color:#ffffff,font-weight:bold
    classDef process fill:#eff6ff,stroke:#60a5fa,color:#1e3a8a
    classDef ai fill:#dbeafe,stroke:#1e40af,color:#1e3a8a
    classDef decision fill:#f8fafc,stroke:#64748b,color:#334155
    classDef data fill:#e2e8f0,stroke:#475569,color:#1e293b

    Start(["شروع"]):::startEnd --> A["دریافت پیام کاربر"]:::process
    A --> B["تشخیص نیت پیام<br/>(سرویس FAISS)"]:::ai
    B --> C{"نوع نیت؟"}:::decision

    C -->|"نوبت"| D["استخراج اطلاعات نوبت با LLM<br/>(پزشک، خدمت، تاریخ، ساعت)"]:::ai
    D --> E{"اطلاعات کامل است؟"}:::decision
    E -->|"خیر"| F["پرسش تکمیلی از کاربر"]:::process
    F --> D
    E -->|"بله"| G[("ثبت نوبت در پایگاه‌داده")]:::data
    G --> H["نمایش تأیید نهایی به کاربر"]:::process

    C -->|"پشتیبانی"| I["جستجو در پایگاه دانش<br/>(Qdrant)"]:::ai
    I --> J{"پاسخ مستقیم یافت شد؟"}:::decision
    J -->|"بله"| K["ارسال پاسخ کلیدواژه‌ای"]:::process
    J -->|"خیر"| L["یافتن نزدیک‌ترین سند<br/>(جستجوی برداری)"]:::ai
    L --> M["بازنویسی پاسخ با LLM"]:::ai

    K --> End(["پایان"]):::startEnd
    M --> End
    H --> End
