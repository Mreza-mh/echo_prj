%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#f1f5f9','primaryBorderColor':'#334155','primaryTextColor':'#1e293b','lineColor':'#64748b','fontSize':'15px'}}}%%
flowchart TD
    classDef startEnd fill:#334155,stroke:#1e293b,color:#fff,font-weight:bold
    classDef process fill:#e2e8f0,stroke:#475569,color:#1e293b
    classDef decision fill:#f1f5f9,stroke:#334155,color:#1e293b
    classDef ai fill:#dbeafe,stroke:#1e40af,color:#1e3a8a
    classDef data fill:#e5e7eb,stroke:#374151,color:#111827

    Start(["fa:fa-play شروع"]):::startEnd --> A["fa:fa-comment کاربر پیام ارسال می‌کند"]:::process
    A --> B["fa:fa-route سرویس FAISS نیت پیام را تشخیص می‌دهد"]:::ai
    B --> C{"fa:fa-question نوع نیت؟"}:::decision

    C -->|"نوبت"| D["fa:fa-robot LLM اطلاعات نوبت را استخراج می‌کند\n(پزشک، خدمت، تاریخ، ساعت)"]:::ai
    D --> E{"fa:fa-check اطلاعات کامل است؟"}:::decision
    E -->|"خیر"| F["fa:fa-question-circle سوال تکمیلی از کاربر پرسیده می‌شود"]:::process
    F --> D
    E -->|"بله"| G[("fa:fa-save ثبت نوبت در پایگاه‌داده")]:::data
    G --> H["fa:fa-check-circle تأیید نهایی به کاربر نمایش داده می‌شود"]:::process

    C -->|"پشتیبانی"| I["fa:fa-search جستجو در پایگاه دانش Qdrant"]:::ai
    I --> J{"fa:fa-bullseye پاسخ مستقیم یافت شد؟"}:::decision
    J -->|"بله"| K["fa:fa-thumbtack پاسخ کلیدواژه‌ای بازگردانده می‌شود"]:::process
    J -->|"خیر"| L["fa:fa-dna نزدیک‌ترین سند با جستجوی برداری"]:::ai
    L --> M["fa:fa-pen پاسخ توسط LLM بازنویسی می‌شود"]:::ai

    K --> N(["fa:fa-stop پایان"]):::startEnd
    M --> N
    H --> N
